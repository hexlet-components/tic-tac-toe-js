{
  "name": "@hexlet/tic-tac-toe",
  "version": "0.0.14",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/src/index.js",
      "types": "./dist/src/index.d.ts"
    },
    "./public/*.css": {
      "import": "./dist/public/*.css"
    }
  },
  "scripts": {
    "dev": "vite",
    "lint": "oxlint .",
    "test": "vitest run",
    "test-preview": "vitest-preview",
    "build:pages": "vite build",
    "build": "rm -rf dist && tsc --build && cp -r public dist/",
    "preview": "vite preview",
    "lint:fix": "oxfmt . && oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.8",
    "nock": "^14.0.17",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "vitest-preview": "^0.0.3"
  },
  "dependencies": {
    "jsdom": "^30.1.3",
    "npm-check-updates": "^23.1.1"
  },
  "engines": {
    "node": ">=26.0"
  },
  "packageManager": "pnpm@12.6.0"
}
